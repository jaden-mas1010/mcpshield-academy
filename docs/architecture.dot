digraph MCPShield {
  graph [bgcolor="#0e1525",pad="0.42",nodesep="0.6",ranksep="0.8",fontname="DejaVu Sans",rankdir="TB",label="MCPShield Academy | Cyber Range Architecture",fontcolor="#f0f6ff",fontsize=19,labelloc="t"];
  node [shape=box,style="rounded,filled",color="#5186B8",fillcolor="#1c2940",fontcolor="#ffffff",fontname="DejaVu Sans",fontsize=11,margin="0.22,0.16",penwidth=1.2];
  edge [color="#80C9EB",penwidth=1.5,arrowsize=0.75,fontcolor="#c5d9ee",fontname="DejaVu Sans",fontsize=9];
  browser [label="Student Browser\nMission cards | JSON editor | Feedback",fillcolor="#233A51"];
  ui [label="Dashboard Server :8088\nHTTP /api/run | /api/grade | /api/lab",fillcolor="#20385B"];
